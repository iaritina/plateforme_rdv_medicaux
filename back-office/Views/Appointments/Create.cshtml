@model back_office.ViewModels.AppointmentCreateVm
@{
    ViewData["Title"] = "Ajouter Type Consultation";
}
<h2>Obtenir RDV</h2>
<form asp-action="Create" method="post">
    <div class="row mb-3">
        <div class="col-3">
            <div class="form-group">
                <label>Type de consultation</label>
                <select class="form-select" aria-label="Default select example"
                        asp-items="Model.ConsultationTypes" asp-for="ConsultationTypeId">
                    <option selected>Open this select menu</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-6">
            <div class="form-group">
                <label>A partir de</label>
                <input asp-for="PreferredStartDate" class="form-control"/>
            </div>
        </div>
        
    </div>

    <div class="row mt-3">
        <div class="col">

            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>

    </div>


</form>
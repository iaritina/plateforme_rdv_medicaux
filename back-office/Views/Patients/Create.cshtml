@model back_office.Models.Patient

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col">
            <!-- Titre en bleu vif, comme dans votre screenshot -->
            <div class="bg-primary text-white p-3 mb-4 rounded-top">
                <h4 class="mb-0">Créer un Patient</h4>
            </div>

            <!-- Formulaire sans card, juste des éléments alignés -->
            <form asp-action="Create" method="post" class="p-4 bg-white">

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">Nom complet</label>
                    <input asp-for="FullName" class="form-control" placeholder="Entrez le nom complet du patient" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DateBirth" class="form-label fw-semibold">Date de naissance</label>
                    <input asp-for="DateBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateBirth" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Gender" class="form-label fw-semibold">Genre</label>
                    <select asp-for="Gender" asp-items="Html.GetEnumSelectList<back_office.Models.Gender>()" class="form-select">
                        <option value="">-- Choisir --</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>

                <!-- Boutons alignés horizontalement -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> Enregistrer
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
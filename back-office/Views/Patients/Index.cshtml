@model IEnumerable<back_office.Models.Patient>

@{
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPatients = ViewBag.TotalPatients ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var sizes = new int[] { 5, 10, 20, 50 };
}

<div class="container mt-4">
    <!-- En-tête : Titre + Bouton Ajouter -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Liste des Patients</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Ajouter un Patient
        </a>
    </div>
    

    <!-- Tableau -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Nom</th>
                    <th>Date de naissance</th>
                    <th>Genre</th>
                    <th scope="col" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Aucun patient trouvé.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.DateBirth.ToString("dd/MM/yyyy")</td>
                            <td>@item.Gender</td>
                            <td class="text-center">
                                <!-- Modifier -->
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-outline-secondary btn-sm me-1">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                <!-- Supprimer -->
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination + Stats en bas -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <!-- Nombre de résultats et sélecteur "Afficher" -->
        <div class="d-flex align-items-center gap-4">
            <!-- Nombre de résultats -->
            <div class="d-flex align-items-center text-muted">
                <i class="bi bi-clipboard-data me-1"></i>
                <span><strong class="text-dark">@totalPatients</strong> résultat(s)</span>
            </div>

            <!-- Sélecteur "Afficher" -->
            <div class="d-flex align-items-center">
                <label for="pageSizeSelect" class="me-2 text-muted small">Afficher :</label>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center"
                            type="button"
                            id="pageSizeDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        @pageSize
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="pageSizeDropdown">
                        @foreach (var size in sizes)
                        {
                            <li>
                                <a class="dropdown-item @(size == pageSize ? "active" : "")"
                                   href="?pageSize=@size&pageNumber=1">@size</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-end mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="1" asp-route-pageSize="@pageSize">&laquo;</a>
                </li>
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage - 1)" asp-route-pageSize="@pageSize">&lt;</a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">Page @currentPage sur @totalPages</span>
                </li>

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage + 1)" asp-route-pageSize="@pageSize">&gt;</a>
                </li>
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@totalPages" asp-route-pageSize="@pageSize">&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
@{
	ViewData["Title"] = "Doctors";
}

@model List<Doctor>

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Liste des Docteurs</h2>
		<a asp-action="DoctorCreateView" class="btn btn-primary">
			<i class="bi bi-plus-circle me-1"></i> Ajouter un docteur
		</a>
	</div>


	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Nom</th>
				<th scope="col">Email</th>
				<th scope="col">Contact</th>
				<th scope="col" class="text-center">Action</th>
			</tr>
			</thead>
			<tbody>
			@{
				foreach (var doctor in Model)
				{
					<tr>

						<th scope="row">@doctor.Id</th>
						<td>@doctor.FullName</td>
						<td>@doctor.Email</td>
						<td>@doctor.Contact</td>
						<td class="text-center">
							<!-- Modifier -->
							<a asp-action="DoctorEditView" asp-route-id="@doctor.Id"
							   class="btn btn-outline-secondary btn-sm me-1">
								<i class="bi bi-pencil-fill"></i>
							</a>

							<!-- Supprimer -->
							<form asp-action="DeleteDoctor" asp-route-id="@doctor.Id" method="post" class="d-inline">
								<button type="submit" class="btn btn-outline-danger btn-sm">
									<i class="bi bi-trash-fill"></i>
								</button>
							</form>
							<!-- rdv -->
							<a asp-action="DoctorCalendar" asp-route-id="@doctor.Id"
							   class="btn btn-outline-secondary btn-sm me-1">
								<i class="bi bi-calendar-date"></i>
							</a>
						</td>
					</tr>
				}
			}
			</tbody>
		</table>
		<nav>
			<ul class="pagination justify-content-center">
				@for (int i = 1; i <= ViewBag.TotalPages; i++)
				{
					<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
						<a class="page-link" asp-action="Doctors" asp-route-page="@i">@i</a>
					</li>
				}
			</ul>
		</nav>
	</div>
</div>
@{
	ViewData["Title"] = "Doctors";
}
<div class="text-center">
	<h1 class="display-4">Voici la liste des docteurs</h1>

</div>

@model List<Doctor> 
<div class="row">
	<div class="col">
		<a asp-controller="Doctor" asp-action="DoctorCreateView"><button type="button" class="btn btn-primary">Ajouter un docteur</button></a>
	</div>
</div>

<div class="text-start">
	<table class="table">
		<thead>
		<tr>
			<th scope="col">#</th>
			<th scope="col">Nom</th>
			<th scope="col">Email</th>
			<th scope="col">Contact</th>
			<th scope="col" class="text-center">Action</th>
		</tr>
		</thead>
		<tbody>
		@{
			foreach (var doctor in Model)
			{
				<tr>

					<th scope="row">@doctor.Id</th>
					<td>@doctor.FullName</td>
					<td>@doctor.Email</td>
					<td>@doctor.Contact</td>
					<td class="text-center">
						<!-- Modifier -->
						<a asp-action="DoctorEditView" asp-route-id="@doctor.Id"
						   class="btn btn-outline-secondary btn-sm me-1">
							<i class="bi bi-pencil-fill"></i>
						</a>

						<!-- Supprimer -->
						<form asp-action="DeleteDoctor" asp-route-id="@doctor.Id" method="post" class="d-inline">
							<button type="submit" class="btn btn-outline-danger btn-sm">
								<i class="bi bi-trash-fill"></i>
							</button>
						</form>
					</td>
				</tr>
			}
		}
		</tbody>
	</table>
	<nav>
		<ul class="pagination justify-content-center">
			@for (int i = 1; i <= ViewBag.TotalPages; i++)
			{
				<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
					<a class="page-link" asp-action="Doctors" asp-route-page="@i">@i</a>
				</li>
			}
		</ul>
	</nav>
</div>

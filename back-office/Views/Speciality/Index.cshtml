
@{
    ViewData["Title"] = "Liste Spécialités";
}

@model List<Specialities>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Liste des Spécialités</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Ajouter un Spécialité
        </a>
    </div>


    <!-- Tableau -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-light">
            <tr>
                <th>Nom</th>
                <th scope="col" class="text-center">Action</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
            <tr>
                    <td colspan="4" class="text-center text-muted py-4">Aucune Spécialité trouvée.</td>
                </tr>
            }
            else
            {
            @foreach (var item in Model)
                {
                <tr>
                        <td>@item.NameSpec</td>
                        <td class="text-center">
                            <!-- Modifier -->
                            <a asp-action="Edit" asp-route-id="@item.IdSpec"
                               class="btn btn-outline-secondary btn-sm me-1">
                                <i class="bi bi-pencil-fill"></i>
                            </a>

                            <!-- Supprimer -->
                            <form asp-action="Delete" asp-route-id="@item.IdSpec" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

